   "source": [
    "# ============================================================\n",
    "# Hv5 — BMY1 PROCESSING UNDER STRESS\n",
    "# FINAL PUBLICATION VERSION\n",
    "#\n",
    "# Processing definition identical to Hv4:\n",
    "#\n",
    "#   Total peptide signal = TT + ST\n",
    "#\n",
    "#   Processing fraction = ST / (TT + ST)\n",
    "#\n",
    "# PANEL A:\n",
    "#   Late-stage BMY1 processing\n",
    "#   = values at 72, 84 and 96 h\n",
    "#\n",
    "#   - boxplots\n",
    "#   - individual late-stage values\n",
    "#   - matching timepoints connected across conditions\n",
    "#   - effect size vs Control shown as % change\n",
    "#   - no non-significant p-values displayed\n",
    "#\n",
    "# PANEL B:\n",
    "#   Full BMY1 processing profile from 0–96 h\n",
    "#\n",
    "#   - one trajectory per condition\n",
    "#   - processing slope calculated for each condition\n",
    "#   - slopes shown in legend\n",
    "#   - Time × Condition interaction model vs Control\n",
    "#   - only significant interaction annotated\n",
    "#\n",
    "# IMPORTANT:\n",
    "#   Hv5 contains one measured trajectory per condition.\n",
    "#   Therefore trajectory statistics describe differences\n",
    "#   between measured time courses and are not biological\n",
    "#   replicate-level treatment inference.\n",
    "#\n",
    "# GRAPHICS:\n",
    "#   - BOTH PANELS = 7.0 × 5.0 cm\n",
    "#   - Arial 6 pt\n",
    "#   - box strokes = 0.25\n",
    "#   - point size = 3.4\n",
    "#   - point white stroke = 0.15\n",
    "#   - frame = 0.40\n",
    "#   - tick width = 0.30\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# IMPORTS\n",
    "# ============================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib\n",
    "\n",
    "from pathlib import Path\n",
    "from matplotlib.ticker import MultipleLocator, FormatStrFormatter\n",
    "\n",
    "import statsmodels.formula.api as smf\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PDF / ILLUSTRATOR SETTINGS\n",
    "# ============================================================\n",
    "\n",
    "matplotlib.rcParams[\"pdf.fonttype\"] = 42\n",
    "matplotlib.rcParams[\"ps.fonttype\"] = 42\n",
    "matplotlib.rcParams[\"svg.fonttype\"] = \"none\"\n",
    "matplotlib.rcParams[\"font.family\"] = \"Arial\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PATHS\n",
    "# ============================================================\n",
    "\n",
    "BASE_DIR = Path.cwd().resolve()\n",
    "\n",
    "while not (\n",
    "    (BASE_DIR / \"main\" / \"import\").exists()\n",
    "    and\n",
    "    (BASE_DIR / \"main\" / \"scripts\").exists()\n",
    "):\n",
    "\n",
    "    if BASE_DIR.parent == BASE_DIR:\n",
    "        raise RuntimeError(\n",
    "            \"Could not find project root\"\n",
    "        )\n",
    "\n",
    "    BASE_DIR = BASE_DIR.parent\n",
    "\n",
    "\n",
    "BASE_DIR = BASE_DIR / \"main\"\n",
    "\n",
    "DATA_DIR = (\n",
    "    BASE_DIR\n",
    "    / \"import\"\n",
    "    / \"Hv5\"\n",
    "    / \"Hv5_bmyprocessing\"\n",
    ")\n",
    "\n",
    "OUTDIR = (\n",
    "    BASE_DIR\n",
    "    / \"export\"\n",
    "    / \"Hv5\"\n",
    "    / \"bmyprocessing\"\n",
    ")\n",
    "\n",
    "OUTDIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# INPUT FILES\n",
    "# ============================================================\n",
    "\n",
    "TRIPTIC_FILE = (\n",
    "    DATA_DIR\n",
    "    / \"Hv5_log2_LQPFPFQEHTDLPVGPTGGMGGQAEGPTCGMGGQVK_TRYPTIC.csv\"\n",
    ")\n",
    "\n",
    "SEMITRIPTIC_FILE = (\n",
    "    DATA_DIR\n",
    "    / \"Hv5_log2_GQAEGPTCGMGGQVK.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LOAD LOG2(+1) MATRICES\n",
    "# ============================================================\n",
    "\n",
    "triptic_log2 = pd.read_csv(\n",
    "    TRIPTIC_FILE,\n",
    "    index_col=0\n",
    ")\n",
    "\n",
    "semi_log2 = pd.read_csv(\n",
    "    SEMITRIPTIC_FILE,\n",
    "    index_col=0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# ALIGN MATRICES\n",
    "# ============================================================\n",
    "\n",
    "common_conditions = (\n",
    "    triptic_log2.index.intersection(\n",
    "        semi_log2.index\n",
    "    )\n",
    ")\n",
    "\n",
    "common_columns = (\n",
    "    triptic_log2.columns.intersection(\n",
    "        semi_log2.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "triptic_log2 = triptic_log2.loc[\n",
    "    common_conditions,\n",
    "    common_columns\n",
    "].copy()\n",
    "\n",
    "semi_log2 = semi_log2.loc[\n",
    "    common_conditions,\n",
    "    common_columns\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CONDITIONS\n",
    "# ============================================================\n",
    "\n",
    "condition_keys = [\n",
    "    \"std\",\n",
    "    \"heat\",\n",
    "    \"drought\",\n",
    "    \"combo\"\n",
    "]\n",
    "\n",
    "\n",
    "name_map = {\n",
    "\n",
    "    \"std\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"heat\":\n",
    "        \"Heat\",\n",
    "\n",
    "    \"drought\":\n",
    "        \"Drought\",\n",
    "\n",
    "    \"combo\":\n",
    "        \"Combined\"\n",
    "}\n",
    "\n",
    "\n",
    "condition_order = [\n",
    "    \"Control\",\n",
    "    \"Heat\",\n",
    "    \"Drought\",\n",
    "    \"Combined\"\n",
    "]\n",
    "\n",
    "\n",
    "expected_conditions = set(\n",
    "    condition_keys\n",
    ")\n",
    "\n",
    "\n",
    "missing_conditions = (\n",
    "    expected_conditions.difference(\n",
    "        common_conditions\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if missing_conditions:\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Missing expected conditions: \"\n",
    "        f\"{sorted(missing_conditions)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# BACK-TRANSFORM LOG2(+1)\n",
    "# ============================================================\n",
    "\n",
    "TT = (\n",
    "    2 ** triptic_log2\n",
    ") - 1\n",
    "\n",
    "ST = (\n",
    "    2 ** semi_log2\n",
    ") - 1\n",
    "\n",
    "\n",
    "TT = TT.clip(\n",
    "    lower=0\n",
    ")\n",
    "\n",
    "ST = ST.clip(\n",
    "    lower=0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PROCESSING FRACTION\n",
    "#\n",
    "# Processing = ST / (TT + ST)\n",
    "# ============================================================\n",
    "\n",
    "processing = (\n",
    "    ST\n",
    "    /\n",
    "    (TT + ST)\n",
    ")\n",
    "\n",
    "\n",
    "processing = processing.replace(\n",
    "    [np.inf, -np.inf],\n",
    "    np.nan\n",
    ")\n",
    "\n",
    "\n",
    "processing.index.name = None\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# TIME POINTS\n",
    "# ============================================================\n",
    "\n",
    "time_map = {\n",
    "\n",
    "    \"0h\": 0,\n",
    "\n",
    "    \"12h\": 12,\n",
    "\n",
    "    \"24h\": 24,\n",
    "\n",
    "    \"36h\": 36,\n",
    "\n",
    "    \"48h\": 48,\n",
    "\n",
    "    \"60h\": 60,\n",
    "\n",
    "    \"72h\": 72,\n",
    "\n",
    "    \"84h\": 84,\n",
    "\n",
    "    \"96h\": 96\n",
    "}\n",
    "\n",
    "\n",
    "time_cols = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in time_map\n",
    "\n",
    "    if c in processing.columns\n",
    "]\n",
    "\n",
    "\n",
    "times = np.array(\n",
    "\n",
    "    [\n",
    "        time_map[c]\n",
    "        for c in time_cols\n",
    "    ],\n",
    "\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "if len(time_cols) < 2:\n",
    "\n",
    "    raise ValueError(\n",
    "        \"Fewer than two valid timepoints found.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LATE TIMEPOINTS\n",
    "# ============================================================\n",
    "\n",
    "late_cols = [\n",
    "    \"72h\",\n",
    "    \"84h\",\n",
    "    \"96h\"\n",
    "]\n",
    "\n",
    "\n",
    "missing_late = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in late_cols\n",
    "\n",
    "    if c not in processing.columns\n",
    "]\n",
    "\n",
    "\n",
    "if missing_late:\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Missing late-stage columns: \"\n",
    "        f\"{missing_late}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LATE-STAGE LONG TABLE\n",
    "# ============================================================\n",
    "\n",
    "late_long = (\n",
    "    processing.loc[\n",
    "        condition_keys,\n",
    "        late_cols\n",
    "    ]\n",
    "    .rename(\n",
    "        index=name_map\n",
    "    )\n",
    "    .rename_axis(\n",
    "        \"Condition\"\n",
    "    )\n",
    "    .reset_index()\n",
    "    .melt(\n",
    "        id_vars=\"Condition\",\n",
    "        var_name=\"Time\",\n",
    "        value_name=\"Processing\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "late_long[\"Condition\"] = pd.Categorical(\n",
    "\n",
    "    late_long[\"Condition\"],\n",
    "\n",
    "    categories=condition_order,\n",
    "\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LATE-STAGE MEAN\n",
    "# ============================================================\n",
    "\n",
    "late_processing = (\n",
    "    processing[\n",
    "        late_cols\n",
    "    ]\n",
    "    .mean(\n",
    "        axis=1,\n",
    "        skipna=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PROCESSING SLOPE\n",
    "# ============================================================\n",
    "\n",
    "def calculate_slope(row):\n",
    "\n",
    "    y = (\n",
    "        row[\n",
    "            time_cols\n",
    "        ]\n",
    "        .astype(float)\n",
    "        .values\n",
    "    )\n",
    "\n",
    "    valid = np.isfinite(\n",
    "        y\n",
    "    )\n",
    "\n",
    "    if valid.sum() < 2:\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    x = times[\n",
    "        valid\n",
    "    ]\n",
    "\n",
    "    y = y[\n",
    "        valid\n",
    "    ]\n",
    "\n",
    "\n",
    "    return np.polyfit(\n",
    "        x,\n",
    "        y,\n",
    "        1\n",
    "    )[0]\n",
    "\n",
    "\n",
    "processing_slope = (\n",
    "    processing.apply(\n",
    "        calculate_slope,\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SUMMARY TABLE\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame({\n",
    "\n",
    "    \"Condition_key\":\n",
    "        processing.index.to_numpy(),\n",
    "\n",
    "    \"Condition\":\n",
    "        processing.index.map(\n",
    "            name_map\n",
    "        ).to_numpy(),\n",
    "\n",
    "    \"Late_processing\":\n",
    "        late_processing.to_numpy(),\n",
    "\n",
    "    \"Processing_slope\":\n",
    "        processing_slope.to_numpy()\n",
    "})\n",
    "\n",
    "\n",
    "summary[\"Condition\"] = pd.Categorical(\n",
    "\n",
    "    summary[\"Condition\"],\n",
    "\n",
    "    categories=condition_order,\n",
    "\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "summary = (\n",
    "    summary\n",
    "    .sort_values(\n",
    "        \"Condition\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Processing_rate_x1e3\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"Processing_slope\"\n",
    "    ]\n",
    "    * 1000\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# EFFECT SIZE VS CONTROL\n",
    "# ============================================================\n",
    "\n",
    "control_late = (\n",
    "    summary.loc[\n",
    "        summary[\"Condition\"] == \"Control\",\n",
    "        \"Late_processing\"\n",
    "    ]\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "\n",
    "control_slope = (\n",
    "    summary.loc[\n",
    "        summary[\"Condition\"] == \"Control\",\n",
    "        \"Processing_slope\"\n",
    "    ]\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Delta_late_vs_Control\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"Late_processing\"\n",
    "    ]\n",
    "    -\n",
    "    control_late\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Delta_slope_vs_Control\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"Processing_slope\"\n",
    "    ]\n",
    "    -\n",
    "    control_slope\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Percent_change_late_vs_Control\"\n",
    "] = (\n",
    "\n",
    "    summary[\n",
    "        \"Delta_late_vs_Control\"\n",
    "    ]\n",
    "\n",
    "    /\n",
    "    control_late\n",
    "\n",
    "    * 100\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FULL TIME-COURSE LONG TABLE\n",
    "# ============================================================\n",
    "\n",
    "profile_rows = []\n",
    "\n",
    "\n",
    "for key in condition_keys:\n",
    "\n",
    "    condition_name = (\n",
    "        name_map[\n",
    "            key\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for col in time_cols:\n",
    "\n",
    "        value = (\n",
    "            processing.loc[\n",
    "                key,\n",
    "                col\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        if not np.isfinite(\n",
    "            value\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "\n",
    "        profile_rows.append({\n",
    "\n",
    "            \"Condition\":\n",
    "                condition_name,\n",
    "\n",
    "            \"Time\":\n",
    "                float(\n",
    "                    time_map[\n",
    "                        col\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"Processing\":\n",
    "                float(\n",
    "                    value\n",
    "                )\n",
    "        })\n",
    "\n",
    "\n",
    "profile_df = pd.DataFrame(\n",
    "    profile_rows\n",
    ")\n",
    "\n",
    "\n",
    "profile_df[\"Condition\"] = pd.Categorical(\n",
    "\n",
    "    profile_df[\"Condition\"],\n",
    "\n",
    "    categories=condition_order,\n",
    "\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# TIME × CONDITION MODEL\n",
    "#\n",
    "# Processing ~ Time * Condition\n",
    "#\n",
    "# Control = reference\n",
    "# ============================================================\n",
    "\n",
    "profile_model = smf.ols(\n",
    "\n",
    "    formula=(\n",
    "        \"Processing ~ \"\n",
    "        \"Time * \"\n",
    "        \"C(Condition, Treatment(reference='Control'))\"\n",
    "    ),\n",
    "\n",
    "    data=profile_df\n",
    ").fit()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# EXTRACT INTERACTION RESULTS\n",
    "# ============================================================\n",
    "\n",
    "interaction_stats = []\n",
    "\n",
    "\n",
    "for condition in [\n",
    "    \"Heat\",\n",
    "    \"Drought\",\n",
    "    \"Combined\"\n",
    "]:\n",
    "\n",
    "    term = (\n",
    "        \"Time:\"\n",
    "        \"C(Condition, Treatment(reference='Control'))\"\n",
    "        f\"[T.{condition}]\"\n",
    "    )\n",
    "\n",
    "\n",
    "    if term not in profile_model.params.index:\n",
    "\n",
    "        raise ValueError(\n",
    "            f\"Interaction term not found: {term}\"\n",
    "        )\n",

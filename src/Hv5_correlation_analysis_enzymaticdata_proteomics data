    "from scipy.stats import spearmanr\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# ============================================================\n",
    "# 16) Profile-matching correlation at 96h (NO BOOTSTRAP)\n",
    "# ============================================================\n",
    "\n",
    "conditions = [\"Control\", \"Heat\", \"Drought\", \"Combined\"]\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Mean enzyme activity profile per family (FIXED reference)\n",
    "# ------------------------------------------------------------\n",
    "enz_profile = (\n",
    "    enz_long\n",
    "    .groupby([\"Enzyme\", \"Condition\"], as_index=False)[\"Activity_norm\"]\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "def get_enzyme_vector(fam):\n",
    "    \"\"\"Return enzyme activity vector in correct condition order\"\"\"\n",
    "    return (\n",
    "        enz_profile[enz_profile[\"Enzyme\"] == fam]\n",
    "        .set_index(\"Condition\")\n",
    "        .loc[conditions, \"Activity_norm\"]\n",
    "        .values\n",
    "    )\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Families to test (biological order)\n",
    "# ------------------------------------------------------------\n",
    "family_order = [\n",
    "    \"Alpha-amylase\",\n",
    "    \"Beta-amylase\",\n",
    "    \"Limit dextrinase\",\n",
    "    \"Lichenase\"\n",
    "]\n",
    "families_to_test = [\n",
    "    f for f in family_order\n",
    "    if f in candidate_tbl[\"enzyme_family\"].unique()\n",
    "]\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Correlation computation (core logic)\n",
    "# ------------------------------------------------------------\n",
    "corr_rows = []\n",
    "raw_rows  = []\n",
    "\n",
    "for fam in families_to_test:\n",
    "\n",
    "    enz_vec = get_enzyme_vector(fam)\n",
    "\n",
    "    prot_sub = prot_96_wide[prot_96_wide[\"enzyme_family\"] == fam]\n",
    "\n",
    "    for _, row in prot_sub.iterrows():\n",
    "\n",
    "        prot_vec = np.asarray(\n",
    "            [row.get(c, np.nan) for c in conditions],\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        ok = np.isfinite(prot_vec) & np.isfinite(enz_vec)\n",
    "\n",
    "        if ok.sum() < 3:\n",
    "            r = np.nan\n",
    "        else:\n",
    "            r = spearmanr(prot_vec[ok], enz_vec[ok]).correlation\n",
    "\n",
    "        corr_rows.append({\n",
    "            \"enzyme_family\": fam,\n",
    "            \"Protein.IDs_pG\": row[\"Protein.IDs_pG\"],\n",
    "            \"r\": r,\n",
    "            \"abs_r\": abs(r) if pd.notna(r) else np.nan,\n",
    "        })\n",
    "\n",
    "        raw_rows.append({\n",
    "            \"enzyme_family\": fam,\n",
    "            \"Protein.IDs_pG\": row[\"Protein.IDs_pG\"],\n",
    "            \"prot_Control\":   prot_vec[0],\n",
    "            \"prot_Heat\":      prot_vec[1],\n",
    "            \"prot_Drought\":   prot_vec[2],\n",

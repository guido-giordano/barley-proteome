    "# ============================================================\n",
    "# Hv5 — Grain composition plots (Nature-style, manuscript size)\n",
    "# Final size ≈ 12 cm × 4.5 cm\n",
    "# ============================================================\n",
    "\n",
    "# -----------------------------\n",
    "# 1) Import plotting libraries\n",
    "# -----------------------------\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# -----------------------------\n",
    "# 2) Grain composition data\n",
    "# -----------------------------\n",
    "grain_data = pd.DataFrame({\n",
    "    \"Condition\": [\"Control\", \"Heat\", \"Drought\", \"Combined\"],\n",
    "    \"TGW\": [56.72, 55.79, 45.24, 40.81],\n",
    "    \"Protein\": [15.0, 14.6, 21.0, 21.8],\n",
    "    \"Starch\": [57.2, 58.4, 42.0, 41.4]\n",
    "})\n",
    "\n",
    "# Long format\n",
    "grain_long = grain_data.melt(\n",
    "    id_vars=\"Condition\",\n",
    "    value_vars=[\"TGW\", \"Protein\", \"Starch\"],\n",
    "    var_name=\"Trait\",\n",
    "    value_name=\"Value\"\n",
    ")\n",
    "\n",
    "# Ordered categories\n",
    "condition_order = [\"Control\", \"Heat\", \"Drought\", \"Combined\"]\n",
    "trait_order = [\"TGW\", \"Protein\", \"Starch\"]\n",
    "\n",
    "grain_long[\"Condition\"] = pd.Categorical(\n",
    "    grain_long[\"Condition\"],\n",
    "    categories=condition_order,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "grain_long[\"Trait\"] = pd.Categorical(\n",
    "    grain_long[\"Trait\"],\n",
    "    categories=trait_order,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "# -----------------------------\n",
    "# 3) Axis labels with units\n",
    "# -----------------------------\n",
    "trait_labels = {\n",
    "    \"TGW\": \"Thousand grain weight (g)\",\n",
    "    \"Protein\": \"Protein (%)\",\n",
    "    \"Starch\": \"Starch (%)\"\n",
    "}\n",
    "\n",
    "# -----------------------------\n",
    "# 4) Nature-style formatting\n",
    "# -----------------------------\n",
    "plt.rcParams[\"font.family\"] = \"Arial\"\n",
    "\n",
    "\n",
    "palette4 = { \"Control\": \"#DDDAD2\", \"Heat\": \"#E36B5D\", \"Drought\": \"#F2C75C\", \"Combined\": \"#7EB5E6\" }\n",
    "# -----------------------------\n",
    "# 5) Figure size\n",
    "# 12 cm × 4.5 cm\n",
    "# -----------------------------\n",
    "cm = 1 / 2.54\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    1, 3,\n",
    "    figsize=(12 * cm, 4.5 * cm),\n",
    "    constrained_layout=True\n",
    ")\n",
    "\n",
    "# Panel labels\n",
    "panel_labels = [\"a\", \"b\", \"c\"]\n",
    "\n",
    "# -----------------------------\n",
    "# 6) Plot panels\n",
    "# -----------------------------\n",
    "for ax, trait, panel in zip(axes, trait_order, panel_labels):\n",
    "\n",
    "    sub = grain_long[grain_long[\"Trait\"] == trait]\n",
    "\n",
    "    # Bars\n",
    "    ax.bar(\n",
    "        sub[\"Condition\"],\n",
    "        sub[\"Value\"],\n",
    "        color=[palette4[c] for c in sub[\"Condition\"]],\n",
    "        edgecolor=\"black\",\n",
    "        linewidth=0.7,\n",
    "        width=0.65\n",
    "    )\n",
    "\n",
    "    # White overlay points\n",
    "    for i, (_, row) in enumerate(sub.iterrows()):\n",
    "        ax.scatter(\n",
    "            i,\n",
    "            row[\"Value\"],\n",
    "            s=18,\n",
    "            facecolor=\"white\",\n",
    "            edgecolor=\"black\",\n",
    "            linewidth=0.6,\n",
    "            zorder=5\n",
    "        )\n",
    "\n",
    "    # Panel label (a, b, c)\n",
    "    ax.text(\n",
    "        -0.28,\n",
    "        1.05,\n",
    "        panel,\n",
    "        transform=ax.transAxes,\n",
    "        fontsize=10,\n",
    "        fontfamily=\"Arial\",\n",
    "        fontweight=\"bold\",\n",
    "        va=\"top\",\n",
    "        ha=\"left\"\n",
    "    )\n",
    "\n",
    "    # Axis labels\n",
    "    ax.set_xlabel(\"\")\n",
    "    ax.set_ylabel(\n",
    "        trait_labels[trait],\n",
    "        fontsize=6,\n",
    "        fontfamily=\"Arial\"\n",
    "    )\n",
    "\n",
    "    # Tick formatting\n",
    "    ax.tick_params(\n",
    "        axis=\"x\",\n",
    "        rotation=45,\n",
    "        labelsize=6,\n",
    "        width=0.6,\n",
    "        length=2\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis=\"y\",\n",
    "        labelsize=6,\n",
    "        width=0.6,\n",
    "        length=2\n",
    "    )\n",
    "\n",
    "    # Ensure Arial everywhere\n",
    "    for label in ax.get_xticklabels():\n",

    "# -----------------------------\n",
    "# 3) Identify iBAQ columns\n",
    "# -----------------------------\n",
    "ibaq_cols = [c for c in df.columns if c.startswith(\"iBAQ_\")]\n",
    "\n",
    "# Drop undesired columns (same logic as R)\n",
    "drop_cols = [\n",
    "    \"iBAQ_std_0hs_std\", \"iBAQ_std_0hs_r2_std\", \"iBAQ_std_0hs_h\",\n",
    "    \"iBAQ_heat_0hs_r2_h\", \"iBAQ_std_0hs_d\", \"iBAQ_drought_0hs_r2_d\",\n",
    "    \"iBAQ_std_0hs_c\", \"iBAQ_combo_0hs_r2_c\"\n",
    "]\n",
    "\n",
    "ibaq_cols = [c for c in ibaq_cols if c not in drop_cols]\n",
    "\n",
    "if len(ibaq_cols) == 0:\n",
    "    raise ValueError(\"No valid iBAQ columns after filtering.\")\n",
    "\n",
    "print(\"Number of iBAQ columns:\", len(ibaq_cols))\n"
   ]

    "# Infer enzyme family from protein ID / gene label\n",
    "def infer_family(pid, label):\n",
    "    if label.startswith(\"Amy\"):\n",
    "        return \"Alpha-amylase\"\n",
    "\n",
    "    if pid in {\n",
    "        \"HORVU.BARKE.PROJ.4HG00380960.1\",\n",
    "        \"HORVU.BARKE.PROJ.2HG00126310.1\",\n",
    "        \"HORVU.BARKE.PROJ.1HG00036700.1\",\n",
    "        \"HORVU.BARKE.PROJ.1HG00036740.1\",\n",
    "        \"HORVU.BARKE.PROJ.1HG00051030.1\",\n",
    "        \"HORVU.BARKE.PROJ.2HG00105510.1\",\n",
    "        \"HORVU.BARKE.PROJ.2HG00126320.1\",\n",
    "        \"HORVU.BARKE.PROJ.3HG00228930.1\",\n",
    "        \"HORVU.BARKE.PROJ.4HG00303690.1\",\n",
    "        \"HORVU.BARKE.PROJ.4HG00376360.1\",\n",
    "        \"HORVU.BARKE.PROJ.6HG00502080.1\",\n",
    "    }:\n",
    "        return \"Beta-amylase\"\n",
    "\n",
    "    if label == \"Lda\":\n",
    "        return \"Limit dextrinase\"\n",
    "\n",
    "    if label.startswith(\"Glb\"):\n",
    "        return \"Lichenase\"\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "candidate_tbl = pd.DataFrame([\n",
    "    {\n",
    "        \"Protein.IDs_pG\": pid,\n",
    "        \"gene_label\": label,\n",
    "        \"enzyme_family\": infer_family(pid, label)\n",
    "    }\n",
    "    for pid, label in candidate_gene_map.items()\n",
    "])\n",
    "\n",
    "candidate_tbl = candidate_tbl.dropna(subset=[\"enzyme_family\"]).reset_index(drop=True)\n",
    "\n",
    "print(\"Number of candidate proteins:\", len(candidate_tbl))\n",
    "candidate_tbl.head()\n",
    "candidate_tbl"
   ]

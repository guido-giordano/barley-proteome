    "# -----------------------------\n",
    "# 4) Parse Condition and Time from column names\n",
    "# -----------------------------\n",
    "def parse_condition(col):\n",
    "    c = col.lower()\n",
    "    if re.search(r\"_std$|_standard_\", c):\n",
    "        return \"Control\"\n",
    "    if re.search(r\"_h$|_heat_\", c):\n",
    "        return \"Heat\"\n",
    "    if re.search(r\"_d$|_drought_\", c):\n",
    "        return \"Drought\"\n",
    "    if re.search(r\"_c$|_combined_\", c):\n",
    "        return \"Combined\"\n",
    "    return None\n",
    "\n",
    "def parse_time(col):\n",
    "    m = re.search(r\"([0-9]{1,3})hs\", col.lower())\n",
    "    return float(m.group(1)) if m else np.nan\n",
    "\n",
    "meta = pd.DataFrame({\n",
    "    \"col\": ibaq_cols,\n",
    "    \"Condition\": [parse_condition(c) for c in ibaq_cols],\n",
    "    \"Time_h\": [parse_time(c) for c in ibaq_cols]\n",
    "})\n",
    "\n",
    "if meta[\"Condition\"].isna().any() or meta[\"Time_h\"].isna().any():\n",
    "    display(meta[meta.isna().any(axis=1)])\n",
    "    raise ValueError(\"Failed to parse Condition or Time_h from some iBAQ columns\")\n",
    "\n",
    "meta[\"Condition\"] = pd.Categorical(\n",
    "    meta[\"Condition\"],\n",
    "    categories=[\"Control\", \"Heat\", \"Drought\", \"Combined\"],\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "meta.head()\n"
   ]
